# Cloudflare D1 & R2 Configuration for CafeFlow Discover
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

NEXT_PUBLIC_PLATFORM_DOMAIN=cafeflow.fun
NEXT_PUBLIC_APP_URL=https://discover.cafeflow.fun
NEXT_PUBLIC_MAIN_APP_URL=https://app.cafeflow.fun

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxx

# Assets
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=cafeflow-assets
R2_PUBLIC_URL=https://assets.cafeflow.fun
